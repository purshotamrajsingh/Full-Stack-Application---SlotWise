// SlotWise — Prisma schema (SQLite)
// Roles: ADMIN | PROVIDER | CUSTOMER  (string + Zod validation, since Prisma enums are not supported on SQLite)
// BookingStatus: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER")
  /** IANA display timezone for customers (staff views stay business-UTC). */
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider?
  bookings Booking[] @relation("CustomerBookings")
  reviews  Review[]
  notifications Notification[]
  waitlist Waitlist[]
  favorites Favorite[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String   @default("")
  durationMin Int
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providers ProviderService[]
  bookings  Booking[]
  waitlist  Waitlist[]
  favorites Favorite[]
}

model Provider {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio        String @default("")
  specialty  String @default("")
  isActive   Boolean @default(true)

  availability Availability[]
  services     ProviderService[]
  bookings     Booking[]
  timeOff      TimeOff[]
  waitlist     Waitlist[]
}

model ProviderService {
  providerId String
  serviceId  String

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
}

// Weekly availability windows. weekday = JS Date.getDay() (0=Sunday .. 6=Saturday).
// startMin/endMin = minutes from midnight, business timezone = UTC.
model Availability {
  id         String @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  weekday  Int
  startMin Int
  endMin   Int

  @@unique([providerId, weekday, startMin])
}

model Booking {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("CustomerBookings", fields: [customerId], references: [id])

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])

  startAt DateTime
  endAt   DateTime

  status String @default("PENDING")
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?
  notifications Notification[]

  @@index([providerId, startAt])
  @@index([customerId, startAt])
  @@index([status])
}

// Provider time off: holidays, sick days, training, partial-day blocks.
// Slots overlapping a window are unbookable (same overlap math as bookings).
model TimeOff {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime
  reason  String   @default("")

  createdAt DateTime @default(now())

  @@index([providerId, startAt])
}

// Mock email outbox: one row per recipient per booking-lifecycle event.
// Mirrors what a production system would send via SMTP/SMS (see README).
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String // booking_created | booking_status | booking_cancelled | booking_rescheduled | time_off_conflict | waitlist_opened
  title     String
  body      String
  bookingId String?

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /** Optional JSON payload powering inline actions (e.g. waitlist deep-link). */
  meta String?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  authorId String
  author   User     @relation(fields: [authorId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
}

// Customer favorites: hearted services surface first in Browse via the
// "Favorites" filter chip.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
}

// Customer slot watchlist: "tell me the moment this slot frees up".
// When the booking holding the slot is cancelled or moved away, every
// matching entry earns a one-shot notification and flips to notified.
model Waitlist {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime

  /** Set the moment the "slot opened" notification fired (one-shot). */
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, providerId, startAt])
  @@index([providerId, startAt])
}
